{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/coffee-rating.ts": {
      "includeFiles": "public/data/**/*.json",
      "maxDuration": 60
    },
    "api/google-rating.ts": {
      "includeFiles": "public/data/**/pizza.json",
      "maxDuration": 15
    },
    "api/price-review.ts": {
      "includeFiles": "public/data/**/locations.json",
      "maxDuration": 30
    },
    "api/prices.ts": {
      "includeFiles": "public/data/**/*.json",
      "maxDuration": 30
    },
    "api/scan-menu.ts": {
      "includeFiles": "public/data/**/*.json",
      "maxDuration": 90
    }
  },
