{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/prices.ts": {
      "includeFiles": "public/data/**/*.json",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/bern",
      "destination": "/index.html"
    },
    {
      "source": "/bern/",
      "destination": "/index.html"
    },
    {
      "source": "/basel",
      "destination": "/index.html"
    },
    {
      "source": "/basel/",
      "destination": "/index.html"
    }
  ]
}
