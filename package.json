{
  "name": "wobillig",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "prices:review": "node --env-file-if-exists=.env.local scripts/price-review.mjs",
    "districts": "node scripts/districts.mjs",
    "test:storage": "RUN_BLOB_INTEGRATION=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/blob.integration.test.ts",
    "test:browser": "playwright test",
    "test:ocr": "RUN_MENU_OCR_LIVE=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/menu-ocr.live.test.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  }
}
