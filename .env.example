# Existing server credentials (never use VITE_ for secrets)
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
MAP_REVIEW_PASSWORD=

# Optional manual approval for every community contribution; normally publish directly.
COMMUNITY_REVIEW_REQUIRED=false
# Emergency switches. Reading the map remains available.
COMMUNITY_WRITES_PAUSED=false
COMMUNITY_PHOTOS_PAUSED=false
# Shared limits for both photo endpoints and all five cities.
COMMUNITY_PHOTO_DAILY_USD=2
COMMUNITY_PHOTO_DAILY_LIMIT=1000
COMMUNITY_PHOTO_HOURLY_LIMIT=100

# Enable only after both Turnstile keys have been installed.
CONTRIBUTION_PROTECTION=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional dedicated, random server secret. Keep stable to retain accounts.
COMMUNITY_AUTH_SECRET=

# SMTP for team@wobillig.ch (Infomaniak)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=team@wobillig.ch
SMTP_PASSWORD=
COMMUNITY_EMAIL_FROM=team@wobillig.ch
COMMUNITY_EMAIL_DAILY_LIMIT=200
# Enable after SMTP and Turnstile have both been tested.
EMAIL_VERIFICATION_REQUIRED=false
